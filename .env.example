LISTEN=0.0.0.0:8787
# Optional second bind that always serves the admin dashboard at /
# ADMIN_LISTEN=127.0.0.1:8788
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ohioismtrade
AUTH_SECRET=change-me-to-at-least-16-chars
APP_URL=https://trade.ohioismquant.vip
ADMIN_URL=https://admin.ohioismquant.vip
# Extra Host values that should serve the admin UI (comma-separated)
# ADMIN_HOSTS=admin.ohioismquant.vip
# Share the session cookie across trade. and admin. (production)
# COOKIE_DOMAIN=.ohioismquant.vip
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# 32 random bytes as 64 hex chars. Same value on trade-api and UK fleet. Never put this in Mongo.
#   openssl rand -hex 32
KEY_WRAP_SECRET=
# Bootstrap only: listed emails become admin at signup. Existing traders are not promoted.
ADMIN_EMAILS=ops@ohioismquant.vip
COOKIE_SECURE=1
PARTNER_SHARE=0.15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Coordinator (Tokyo): one MD feed, no keys
BASE=btc
MINS=15
BINANCE_SYMBOL=btcusdt
MAX_WAVE=80
FLEET_ADDR=127.0.0.1:8090
FLEET_TOKEN=

# Fleet (UK only): decrypts keys, POSTs CLOB
FLEET_BIND=0.0.0.0:8090
PAPER=1
ALLOW_LIVE=0
SHARD=0
SHARDS=1
CHAIN_ID=137
